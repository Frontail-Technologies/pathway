# Pathway API base URL (backend/). Required for sign-in, accounts, saved items, Tutor Space and admin.
# The API must list this site's origin in CORS_ORIGINS (backend/.env), e.g. http://localhost:3000.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google OAuth web client ID for "Continue with Google" on student sign-in and register.
# Leave empty to hide the button. The same ID must be listed in GOOGLE_CLIENT_IDS in backend/.env.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
